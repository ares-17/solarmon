# Copia questo file in "solarmon.env" accanto a solarmon.py (PC) oppure in /etc/solarmon.env (Pi, chmod 600).
# Un parametro per riga, i commenti stanno su righe proprie (niente commenti dopo il valore).
# Le variabili d'ambiente reali hanno la precedenza sul file.

# --- inverter ---
INVERTER_DEV=/dev/inverter

# --- tempi, in secondi ---
# Intervallo di lettura (minimo 3, consigliato 5-10).
INTERVAL=10
# Ogni quanto scrivere nel database (SD: non scendere sotto 30).
STORE_INTERVAL=60
# Quanti secondi di letture fini tenere in RAM per /api/raw.
RAW_KEEP=3600

# --- web (dashboard e dati) ---
PORT=8000
# 127.0.0.1 = solo locale (telefono via "tailscale serve" o tunnel SSH).
# Per ascoltare sulla LAN/Tailscale metti l'IP dell'interfaccia, mai 0.0.0.0.
BIND_ADDR=127.0.0.1
# Se impostato, /api/raw richiede ?token=... oppure l'header X-Token.
# Con BIND_ADDR diverso dal loopback e RAW_TOKEN vuoto, /api/raw risponde 403.
RAW_TOKEN=
# Sul PC di prova: DB_PATH=./solar.db   (sulla Pi il default va bene)
#DB_PATH=./solar.db

# --- Telegram ---
TG_TOKEN=
# Il tuo id numerico: e' anche l'id della chat privata con il bot.
TG_CHAT=
# Vuoto = uguale a TG_CHAT.
TG_ADMIN_ID=
# 1 abilita /set (scrittura impostazioni). Con 0 il bot e' solo in lettura.
ALLOW_WRITE=0

# --- notifiche ---
# Le notifiche Telegram sono eventi (passaggio rete/batteria, guasti, inverter muto):
# non ci sono soglie da configurare.

# --- MQTT (facoltativo, per Home Assistant) ---
# Richiede paho-mqtt nel venv: /opt/solarmon/.venv/bin/pip install paho-mqtt
#MQTT_HOST=localhost

# Posizione per le ore di luce (facoltativa). SOLAR_PLACE usa il capoluogo di provincia:
# le coordinate del comune non sono incluse. LAT/LON, se presenti, hanno la precedenza.
# SOLAR_PLACE=Roma, RM
# SOLAR_LAT=41.893
# SOLAR_LON=12.483
